# Server Configuration
PORT=3000
NODE_ENV=development
DEBUG=1

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/breeze_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=breeze_db
DB_PORT=5432

# Redis Cache & PubSub Configuration
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# JWT Authentication Secret (Change in production!)
JWT_SECRET=super-secret-key-change-in-production-min-32-chars-long
