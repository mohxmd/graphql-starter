{
  "name": "breeze",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:update": "drizzle-kit generate && drizzle-kit migrate",
    "db:seed": "bun ./src/drizzle/seed.ts",
    "db:push": "drizzle-kit push",
    "db:start-studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@graphql-yoga/plugin-sofa": "^3.15.2",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.15.2",
    "zod": "^4.1.8"
  }
}
